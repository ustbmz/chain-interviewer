/**app.wxss —— 「链上面试官」全局主题：藏青主色 + 纸感浅底**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f8fa;
  color: #1f2328;
  font-size: 28rpx;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.wrap {
  padding: 16rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

/* 筛选 chips */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 20rpx 0 4rpx;
}
.chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #d0d7de;
  color: #57606a;
  font-size: 24rpx;
  line-height: 1.4;
  box-sizing: border-box;
}
.chip.active {
  background: #2c4d79;
  border-color: #2c4d79;
  color: #ffffff;
  font-weight: 600;
}
.chip .n {
  font-size: 22rpx;
  margin-left: 6rpx;
  opacity: .75;
}

/* 题目卡 */
.qcard {
  margin: 20rpx 0;
}
.qhead {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.qnum {
  flex: none;
  min-width: 56rpx;
  height: 44rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: #eef2f7;
  color: #2c4d79;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  line-height: 44rpx;
  box-sizing: border-box;
}
.qtext {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.55;
  color: #1f2328;
}
.qbadges {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #eef2f7;
  color: #57606a;
}
.badge.known { background: #dafbe1; color: #1a7f37; }
.badge.review { background: #fff3d4; color: #9a6700; }
.hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #9aa4b2;
}
.qbody {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #d0d7de;
}
.atext {
  font-size: 28rpx;
  line-height: 1.75;
  color: #43506b;
}
.acts {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eaeef2;
}
.act {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 14rpx;
  border: 1rpx solid #d0d7de;
  background: #ffffff;
  color: #57606a;
  font-size: 24rpx;
  box-sizing: border-box;
}
.act.primary { background: #2c4d79; border-color: #2c4d79; color: #ffffff; font-weight: 600; }
.act.warn { background: #fff8e6; border-color: #e3c27a; color: #9a6700; }
.act.ghost { color: #9aa4b2; border-style: dashed; }

/* 主按钮 */
.bigbtn {
  margin-top: 40rpx;
  padding: 26rpx 0;
  border-radius: 999rpx;
  background: #2c4d79;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}
.bigbtn.ghost {
  background: #ffffff;
  color: #2c4d79;
  border: 2rpx solid #2c4d79;
}

/* 空态 */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #9aa4b2;
  font-size: 26rpx;
}

/* 进度条 */
.bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: #eaeef2;
  overflow: hidden;
}
.bar > .fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2c4d79, #5e8ab4);
}
