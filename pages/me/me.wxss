/**me.wxss**/
/* 品牌标识 */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 8rpx;
}
.brand-logo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
}
.brand-name {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #2c4d79;
}
.brand-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9aa4b2;
  letter-spacing: 2rpx;
}

.backrow {
  margin: 4rpx 0 16rpx;
  padding: 14rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #2c4d79;
  background: #ffffff;
  border: 1rpx solid #d0d7de;
  border-radius: 999rpx;
}
.total-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.total-pct {
  font-size: 72rpx;
  font-weight: 700;
  color: #2c4d79;
  line-height: 1.1;
}
.total-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9aa4b2;
}
.total-nums {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.tn {
  font-size: 24rpx;
  color: #57606a;
}
.tn.green { color: #1a7f37; }
.tn.amber { color: #9a6700; }
.tn.dim { color: #9aa4b2; }

.sec-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2328;
  margin-bottom: 20rpx;
}
.cat-row {
  margin-bottom: 24rpx;
}
.cat-row:last-child {
  margin-bottom: 0;
}
.cat-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.cat-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #43506b;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.cat-n {
  font-size: 24rpx;
  color: #9aa4b2;
  font-variant-numeric: tabular-nums;
}
.bar.thin {
  height: 10rpx;
}

.about {
  margin-top: 20rpx;
}
.about-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c4d79;
}
.about-line {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #57606a;
  line-height: 1.7;
}
.about-line.dim {
  color: #9aa4b2;
}
.clear {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #cf222e;
  text-align: center;
  padding: 14rpx 0;
  border: 1rpx dashed #d0d7de;
  border-radius: 14rpx;
}
