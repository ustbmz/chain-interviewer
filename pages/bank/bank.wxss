/**bank.wxss**/

/* ===== 极简筛选：分类一行横滑，无边框无卡片 ===== */
.catscroll {
  margin-top: 20rpx;
  width: 100%;
}
.chips.nowrap {
  /* scroll-view 内不换行：内容撑开宽度，横向滑 */
  display: inline-flex;
  flex-wrap: nowrap;
  padding: 4rpx 8rpx 4rpx 0;
  gap: 12rpx;
}
.catscroll .chip {
  padding: 10rpx 26rpx;
}

/* ===== 单题模式 ===== */
.qcard {
  margin-top: 24rpx;
}
.qmeta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.qmeta .badge { flex: none; }
.catname {
  flex: 1;
  font-size: 22rpx;
  color: #9aa4b2;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.qtext {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #1f2328;
}
.qbody {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #d0d7de;
}
.atext {
  display: block;
  font-size: 28rpx;
  line-height: 1.75;
  color: #43506b;
}

/* ===== 切题滑动动画 ===== */
.slide-next {
  animation: slide-next .22s ease-out;
}
.slide-prev {
  animation: slide-prev .22s ease-out;
}
@keyframes slide-next {
  from { opacity: 0; transform: translateX(56rpx); }
  to   { opacity: 1; transform: translateX(0); }
}
@keyframes slide-prev {
  from { opacity: 0; transform: translateX(-56rpx); }
  to   { opacity: 1; transform: translateX(0); }
}

/* ===== 底部操作栏：上一步 / 模拟面试 / 下一步 ===== */
.bottombar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eaeef2;
}
.bbtn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid #d0d7de;
  background: #ffffff;
  color: #2c4d79;
  font-size: 27rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.bbtn.quiz {
  background: #2c4d79;
  border-color: #2c4d79;
  color: #ffffff;
}
.bbtn.off {
  color: #c3ccd6;
  border-color: #eaeef2;
  font-weight: 400;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.qno {
  flex: none;
  min-width: 64rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #2c4d79;
  font-variant-numeric: tabular-nums;
}
.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2c4d79;
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa4b2;
}
.hero-stats {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 24rpx 0 12rpx;
}
.hs-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2328;
}
.hs-dim {
  font-size: 22rpx;
  color: #9aa4b2;
}
