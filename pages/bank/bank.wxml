<navigation-bar title="链上面试官" back="{{false}}" background="#2c4d79" color="white"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list" scroll-top="{{scrollTop}}" bounces="{{false}}">
  <view class="wrap">

    <!-- 顶部：口号 + 总进度 -->
    <view class="card hero">
      <view class="hero-brand">
        <image class="hero-logo" src="/assets/images/logo.png" mode="aspectFit" />
        <view class="hero-title">链上面试官，链下拿 offer</view>
      </view>
      <view class="hero-sub">先自己答，再对照解析，稳稳上岸。</view>
      <view class="hero-stats">
        <text class="hs-main">已掌握 {{stats.known}} / {{stats.total}}</text>
        <text class="hs-dim">待复习 {{stats.review}} · 未掌握 {{stats.todo}}</text>
      </view>
      <view class="bar"><view class="fill" style="width: {{stats.pct}}%"></view></view>
    </view>

    <!-- 筛选：题型单选下拉 -->
    <view class="catselect" bindtap="openCats">
      <text class="cs-label">题型</text>
      <text class="cs-value {{activeCat !== 'all' ? 'picked' : ''}}">{{catLabel}}</text>
      <text class="cs-arrow">▾</text>
    </view>

    <!-- 单题卡片（支持左右滑动切题：右划上一个，左划下一步） -->
    <block wx:if="{{cur}}">
      <view class="qcard card {{anim === 'next' ? 'slide-next' : anim === 'prev' ? 'slide-prev' : ''}}"
        bindtouchstart="onTouchStart"
        bindtouchend="onTouchEnd"
      >
        <view class="qmeta">
          <text class="qnum" style="color: {{cur.color}}">No.{{cur.no}}</text>
          <text class="badge">{{cur.levelName}}</text>
          <text class="catname">{{cur.catName}}</text>
          <text wx:if="{{cur.state === 'known'}}" class="badge known">已掌握</text>
          <text wx:if="{{cur.state === 'review'}}" class="badge review">待复习</text>
        </view>
        <view class="qtext">{{cur.q}}</view>

        <view class="qbody">
          <text class="atext">{{cur.a}}</text>
        </view>

        <view class="acts">
          <view class="act {{cur.state === 'known' ? 'primary' : ''}}" data-id="{{cur.id}}" data-st="known" bindtap="onMark">🧠 已掌握</view>
          <view class="act ghost" data-id="{{cur.id}}" data-st="none" bindtap="onMark">清除</view>
        </view>
      </view>
    </block>

    <view wx:else class="empty">这个分类下没有题目</view>

  </view>
</scroll-view>

<!-- 底部操作栏：上一步 / 模拟面试 / 下一步 -->
<view class="bottombar">
  <view class="bbtn {{curIdx === 0 ? 'off' : ''}}" bindtap="onPrev">‹ 上一题</view>
  <view class="bbtn quiz" bindtap="onQuiz">🎤 模拟面试</view>
  <view class="bbtn next" bindtap="onNext">{{curIdx === list.length - 1 ? '下一步·我的 ›' : '下一题 ›'}}</view>
</view>

<!-- 题型单选弹层：点击即选中并关闭 -->
<view wx:if="{{catPicker}}" class="catmask" bindtap="closeCats">
  <view class="catsheet" catchtap="noop">
    <view class="sheet-head">
      <text class="sheet-title">选择题型</text>
    </view>
    <scroll-view class="sheet-list" scroll-y bounces="{{false}}">
      <view
        wx:for="{{tmpCats}}"
        wx:key="id"
        class="opt {{item.on ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="chooseCat"
      >
        <view class="opt-dot" style="background: {{item.color}};"></view>
        <text class="opt-name">{{item.name}}</text>
        <text class="opt-n">{{item.count}} 题</text>
        <text wx:if="{{item.on}}" class="opt-check">✓</text>
      </view>
    </scroll-view>
  </view>
</view>
