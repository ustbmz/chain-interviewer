/**quiz.wxss**/
.prog {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 8rpx 4rpx 12rpx;
}
.prog-n {
  font-size: 28rpx;
  font-weight: 700;
  color: #2c4d79;
}
.prog-dim {
  font-size: 22rpx;
  color: #9aa4b2;
}
.idle-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c4d79;
}
.idle-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #57606a;
}
.meta {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}
.qq {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.6;
  color: #1f2328;
}
.ans-head {
  margin: 26rpx 0 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #2c4d79;
}
.done {
  text-align: center;
  padding: 60rpx 40rpx;
}
.done-emoji {
  font-size: 80rpx;
}
.done-title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #2c4d79;
}
.done-num {
  margin-top: 20rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #1f2328;
}
.done-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #9aa4b2;
}
